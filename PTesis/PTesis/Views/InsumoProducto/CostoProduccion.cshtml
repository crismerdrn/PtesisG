@model CapaModelo.CMCostoProduccion

@{
    ViewBag.Title = "Análisis de Costo y Rentabilidad";
    var detalles = ViewBag.Detalles as List<CapaModelo.CMDetalleCostoProduccion> ?? new List<CapaModelo.CMDetalleCostoProduccion>();
}

<div class="container-fluid px-4 py-3">
    <!-- Encabezado con Botón de Regreso -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0 text-dark">
                <i class="fas fa-chart-line text-primary me-2"></i>Rentabilidad y Costos
            </h2>
            <span class="text-muted">
                Plato: <strong class="text-dark">@Model.NombreProducto</strong> |
                Sucursal: <span class="badge bg-primary">@(string.IsNullOrWhiteSpace((string)ViewBag.NombrePolleria) ? "El Escondite del Loro" : ViewBag.NombrePolleria)</span>
            </span>
        </div>
        <div>
            <a href="@Url.Action("Index", "InsumoProducto", new { idProducto = Model.id_producto })" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Volver a Recetas
            </a>
        </div>
    </div>

    <!-- Tarjetas de Indicadores Clave -->
    <div class="row g-3 mb-4">
        <!-- Precio Venta -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 border-start border-4 border-primary">
                <div class="card-body">
                    <span class="text-muted text-uppercase fw-semibold small">Precio de Venta</span>
                    <h3 class="fw-bold text-primary mt-2 mb-0">Bs. @Model.PrecioVenta.ToString("N2")</h3>
                </div>
            </div>
        </div>

        <!-- Costo Producción -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 border-start border-4 border-danger">
                <div class="card-body">
                    <span class="text-muted text-uppercase fw-semibold small">Costo Insumos</span>
                    <h3 class="fw-bold text-danger mt-2 mb-0">Bs. @Model.CostoTotalProduccion.ToString("N2")</h3>
                </div>
            </div>
        </div>

        <!-- Ganancia Estimada -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 border-start border-4 border-success">
                <div class="card-body">
                    <span class="text-muted text-uppercase fw-semibold small">Ganancia Unitaria</span>
                    <h3 class="fw-bold text-success mt-2 mb-0">Bs. @Model.GananciaUnitaria.ToString("N2")</h3>
                </div>
            </div>
        </div>

        <!-- Margen de Ganancia y Capacidad -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 border-start border-4 border-info">
                <div class="card-body">
                    <span class="text-muted text-uppercase fw-semibold small">Margen Comercial</span>
                    <h3 class="fw-bold text-info mt-2 mb-0">@Model.PorcentajeMargen.ToString("N1")%</h3>
                    <div class="mt-1">
                        <span class="badge bg-dark">
                            Capacidad: @(Model.UnidadesMaximasProducibles ?? 0) platos
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Desglose de Insumos -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0 text-secondary">
                <i class="fas fa-layer-group me-2"></i>Desglose de la Fórmula y Stock en Cocina
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Insumo</th>
                            <th class="text-center">Porción por Plato</th>
                            <th class="text-end">Último Precio Compra</th>
                            <th class="text-end">Precio Promedio (3M)</th>
                            <th class="text-end">Costo en Plato</th>
                            <th class="text-center">Stock Almacén</th>
                            <th class="text-center">Platos Posibles</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in detalles)
                        {
                            <tr>
                                <td class="fw-semibold">@item.NombreInsumo</td>
                                <td class="text-center">
                                    <span class="fw-bold">@item.cantidad_requerida.ToString("G29")</span>
                                    <span class="badge bg-light text-dark border ms-1">@item.AbreviaturaMedida</span>
                                </td>
                                <td class="text-end">Bs. @item.UltimoPrecioCompra.ToString("N2")</td>
                                <td class="text-end">Bs. @item.PrecioPromedio3Meses.ToString("N2")</td>
                                <td class="text-end fw-bold text-danger">Bs. @item.CostoInsumo.ToString("N2")</td>
                                <td class="text-center">
                                    <span class="badge bg-secondary">
                                        @(item.StockActual.HasValue ? item.StockActual.Value.ToString("G29") : "0") @item.AbreviaturaMedida
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="fw-bold @((item.UnidadesProducibles ?? 0) <= 20 ? "text-danger" : "text-success")">
                                        @(item.UnidadesProducibles ?? 0) platos
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td colspan="4" class="text-end">Costo Total de Producción:</td>
                            <td class="text-end text-danger fs-6">Bs. @Model.CostoTotalProduccion.ToString("N2")</td>
                            <td class="text-end">Límite Producción:</td>
                            <td class="text-center text-primary fs-6">@(Model.UnidadesMaximasProducibles ?? 0) platos</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>