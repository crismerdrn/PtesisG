@model CapaModelo.CMTipoProducto

<div class="container-fluid px-4">
    <div class="card shadow-sm border-0 rounded-4 mt-4">
        <div class="card-header bg-primary text-white rounded-top-4">
            <h4 class="mb-0"><i class="fas fa-box-open me-2"></i>Agregar Tipo de Producto</h4>
        </div>

        <div class="card-body">
            @using (Html.BeginForm("Create", "TipoProducto", FormMethod.Post,
                new { @class = "needs-validation", @novalidate = "novalidate", @id = "formCreate" }))
            {
                @Html.AntiForgeryToken()
                @*@Html.ValidationSummary(true, "", new { @class = "alert alert-danger", @role = "alert" })*@

                <div class="row g-3">
                    <div class="col-md-12">
                        <div class="form-floating">
                            @Html.TextBoxFor(m => m.descripcion,
                                new
                                     {
                                    @class = "form-control",
                                    placeholder = "Descripción",
                                    maxlength = "100",
                                    required = "required",
                                    @id = "descripcion"
                                })
                            @Html.LabelFor(m => m.descripcion, new { @for = "descripcion" })
                            <div class="invalid-feedback">
                                Por favor ingrese una descripción válida.
                            </div>
                            @*@Html.ValidationMessageFor(m => m.descripcion, "", new { @class = "text-danger small mt-1" })*@
                            <div class="form-text text-muted">
                                Máximo 100 caracteres.
                            </div>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-start">
                    <button type="submit" class="btn btn-success me-2" id="btnGuardar">
                        <i class="fas fa-save me-1"></i> Guardar
                    </button>
                    @Html.ActionLink("Volver", "Index", null,
                        new { @class = "btn btn-secondary", @id = "btnVolver" })
                </div>
            }
        </div>
    </div>
</div>

<script>
    (function() {
        'use strict';

        var form = document.getElementById('formCreate');
        var descripcionInput = document.getElementById('descripcion');

        if (form) {
            form.addEventListener('submit', function(event) {
                event.preventDefault();
                event.stopPropagation();

                if (!descripcionInput.value || descripcionInput.value.trim().length === 0) {
                    descripcionInput.classList.add('is-invalid');
                    mostrarError('La descripción es obligatoria.');
                    return false;
                }

                if (descripcionInput.value.trim().length > 100) {
                    descripcionInput.classList.add('is-invalid');
                    mostrarError('La descripción no puede exceder los 100 caracteres.');
                    return false;
                }

                descripcionInput.value = sanitizarInput(descripcionInput.value);

                var btnGuardar = document.getElementById('btnGuardar');
                if (btnGuardar) {
                    btnGuardar.disabled = true;
                    btnGuardar.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Guardando...';
                }

                this.submit();
            });

            descripcionInput.addEventListener('input', function() {
                var valor = this.value;
                var contador = document.getElementById('contadorCaracteres');

                if (!contador) {
                    contador = document.createElement('div');
                    contador.id = 'contadorCaracteres';
                    contador.className = 'form-text text-end small mt-1';
                    this.parentNode.appendChild(contador);
                }

                var caracteresRestantes = 100 - valor.length;
                contador.textContent = caracteresRestantes + ' caracteres restantes';
                contador.className = 'form-text text-end small mt-1 ' +
                    (caracteresRestantes < 20 ? 'text-warning' : 'text-muted');

                if (valor.length > 100) {
                    this.classList.add('is-invalid');
                } else {
                    this.classList.remove('is-invalid');
                }
            });
        }

        function sanitizarInput(texto) {
            if (!texto) return '';
            return texto.trim()
                .replace(/[<>]/g, '')
                .replace(/&/g, '&amp;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function mostrarError(mensaje) {
            var alertDiv = document.createElement('div');
            alertDiv.className = 'alert alert-danger alert-dismissible fade show mt-3';
            alertDiv.innerHTML = `
                <i class="fas fa-exclamation-circle me-2"></i>${mensaje}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            form.insertBefore(alertDiv, form.firstChild);

            setTimeout(function() {
                alertDiv.remove();
            }, 5000);
        }
    })();
</script>