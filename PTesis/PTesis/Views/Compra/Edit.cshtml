@model CapaModelo.CMCompra

@{
    ViewBag.Title = "Editar Compra";
}

<div class="container-fluid px-4">
    <div class="card shadow-sm border-0 rounded-4 mt-4">
        <div class="card-header bg-warning text-dark rounded-top-4">
            <h4 class="mb-0"><i class="fas fa-edit me-2"></i>Editar Compra #@Model.id_compra</h4>
        </div>

        <div class="card-body">
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>
                <strong>Importante:</strong>
                <ul class="mb-0">
                    <li>Solo se pueden editar compras con estado <strong>PENDIENTE</strong>.</li>
                    <li>
                        Estado actual:
                        @if (Model.Estado == "PENDIENTE")
                        {
                            <span class="badge bg-warning text-dark">PENDIENTE</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@Model.Estado</span>
                        }
                    </li>
                    <li>La edición actualizará los datos y reemplazará los ítems correspondientes.</li>
                </ul>
            </div>

            @using (Html.BeginForm("Edit", "Compra", new { id = Model.id_compra }, FormMethod.Post, new { id = "formCompra" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.id_compra)

                <!-- Hidden para detalles en JSON -->
                <input type="hidden" id="detallesJson" name="detallesJson" value="@Html.Raw(ViewBag.DetallesJson ?? "[]")" />

                <!-- Hidden para pollería -->
                <input type="hidden" id="IdPolleria" name="IdPolleria" value="@(ViewBag.IdPolleria ?? 0)" />

                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="form-floating">
                            @Html.TextBoxFor(m => m.Referencia,
                                new
                                {
                                    @class = "form-control",
                                    placeholder = "Referencia",
                                    maxlength = "50"
                                })
                            <label for="Referencia">Referencia (Opcional)</label>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating">
                            @Html.DropDownListFor(m => m.PROVEEDOR_id_proveedor,
                                ViewBag.ListaProveedores as SelectList,
                                "Seleccione un proveedor",
                                new
                                {
                                    @class = "form-select",
                                    id = "ProveedorSelect",
                                    required = "required"
                                })
                            <label for="ProveedorSelect">Proveedor *</label>
                            @Html.ValidationMessageFor(m => m.PROVEEDOR_id_proveedor, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating">
                            <input type="text" class="form-control bg-light"
                                   id="PolleriaInfo" readonly
                                   value="@(ViewBag.PolleriaActual != null ? ViewBag.PolleriaActual.Nombre : "Pollería principal")" />
                            <label for="PolleriaInfo">Pollería de Almacenamiento</label>
                            <small class="text-muted">
                                <i class="fas fa-info-circle"></i> El stock se actualizará en esta pollería
                            </small>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating">
                            @Html.DropDownListFor(m => m.TIPO_COMPRA_id_tipoCompra,
                                ViewBag.ListaTiposCompra as SelectList,
                                "Seleccione tipo",
                                new
                                {
                                    @class = "form-select",
                                    id = "TipoCompraSelect"
                                })
                            <label for="TipoCompraSelect">Tipo de Compra</label>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating">
                            @Html.DropDownListFor(m => m.IdTipoPago,
                                ViewBag.ListaTiposPago as SelectList,
                                "Seleccione método",
                                new
                                {
                                    @class = "form-select",
                                    id = "TipoPagoSelect",
                                    required = "required"
                                })
                            <label for="TipoPagoSelect">Método de Pago *</label>
                            @Html.ValidationMessageFor(m => m.IdTipoPago, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating">
                            <input type="date" class="form-control"
                                   id="FechaCompra" name="FechaCompra"
                                   value="@Model.FechaCompra.ToString("yyyy-MM-dd")" />
                            <label for="FechaCompra">Fecha de Compra</label>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating">
                            @Html.DropDownListFor(m => m.Estado,
                                ViewBag.ListaEstados as SelectList,
                                new
                                {
                                    @class = "form-select",
                                    id = "EstadoSelect"
                                })
                            <label for="EstadoSelect">Estado</label>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating">
                            <input type="text" class="form-control bg-light fw-bold text-primary"
                                   id="MontoTotal" name="MontoTotal"
                                   value="@Model.MontoTotal.ToString("0.00")" readonly />
                            <label for="MontoTotal">Monto Total (Bs.)</label>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <!-- Sección de Detalles -->
                <div class="card bg-light border">
                    <div class="card-header bg-light">
                        <h5 class="mb-0"><i class="fas fa-list me-2"></i>Detalles de la Compra</h5>
                    </div>
                    <div class="card-body">
                        <!-- Buscador de Items -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-6 position-relative">
                                <div class="input-group">
                                    <span class="input-group-text bg-light">
                                        <i class="fas fa-search"></i>
                                    </span>
                                    <input type="text" id="buscadorItem" class="form-control"
                                           placeholder="Buscar producto o insumo..." autocomplete="off" />
                                    <button class="btn btn-outline-secondary dropdown-toggle" type="button"
                                            data-bs-toggle="dropdown" id="btnFiltroTipo">
                                        <i class="fas fa-filter"></i> Todos
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" href="#" data-tipo="TODOS">Todos</a></li>
                                        <li><a class="dropdown-item" href="#" data-tipo="PRODUCTO">Solo Productos</a></li>
                                        <li><a class="dropdown-item" href="#" data-tipo="INSUMO">Solo Insumos</a></li>
                                    </ul>
                                </div>
                                <div id="resultadosBusqueda" class="list-group shadow position-absolute start-0 end-0 mt-1 mx-2"
                                     style="display: none; z-index: 1060; max-height: 250px; overflow-y: auto;"></div>
                            </div>
                        </div>

                        <!-- Tabla de Detalles -->
                        <div class="table-responsive">
                            <table class="table table-bordered bg-white align-middle" id="tablaDetalles">
                                <thead class="table-light">
                                    <tr>
                                        <th width="35%">Item</th>
                                        <th width="15%">Cantidad</th>
                                        <th width="15%">Precio Unit.</th>
                                        <th width="15%">Subtotal</th>
                                        <th width="10%">Medida</th>
                                        <th width="10%" class="text-center">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody id="cuerpoDetalles">
                                    <tr id="sinDetalles">
                                        <td colspan="6" class="text-center py-3 text-muted">
                                            <i class="fas fa-info-circle me-2"></i> No hay items agregados a la compra
                                        </td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="3" class="text-end fw-bold">TOTAL:</td>
                                        <td class="text-end fw-bold text-primary fs-6" id="totalCompra">Bs. @Model.MontoTotal.ToString("0.00")</td>
                                        <td colspan="2"></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <div class="alert alert-info mt-3">
                            <i class="fas fa-lightbulb me-2"></i>
                            <small>
                                Para agregar items, busque en el campo de arriba y seleccione el producto o insumo deseado.
                            </small>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <!-- Botones -->
                <div class="d-flex justify-content-between">
                    <div>
                        <button type="button" class="btn btn-outline-danger" onclick="limpiarFormulario()">
                            <i class="fas fa-times me-1"></i> Cancelar
                        </button>
                    </div>
                    <div class="d-flex gap-2">
                        @Html.ActionLink("Volver al Detalle", "Details", new { id = Model.id_compra },
                            new { @class = "btn btn-secondary px-4" })
                        <button type="submit" class="btn btn-warning px-4">
                            <i class="fas fa-save me-1"></i> Actualizar Compra
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Styles {
    <style>
        input.sin-spinners::-webkit-outer-spin-button,
        input.sin-spinners::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        input.sin-spinners[type=number] {
            -moz-appearance: textfield;
        }
    </style>
}

@section JavaScript{
    <script>
        const COMPRA_CONFIG = {
            urlBuscarProductos: '@Url.Action("BuscarProductos", "Compra")',
            urlBuscarInsumos: '@Url.Action("BuscarInsumos", "Compra")',
            idPolleria: parseInt('@(ViewBag.IdPolleria ?? 0)', 10) || 0
        };

        $(document).ready(function () {
            try {
                var detallesIniciales = @Html.Raw(ViewBag.DetallesJson ?? "[]");
                if (detallesIniciales && detallesIniciales.length > 0) {
                    $('#sinDetalles').hide();
                    detalles = detallesIniciales;
                    detalles.forEach(function (item, index) {
                        agregarFilaDetalle(item, index);
                    });
                    actualizarTotal();
                }
            } catch (e) {
                console.error("Error al cargar detalles iniciales:", e);
            }
        });
    </script>
    <script src="~/Scripts/compra-create.js?v=@DateTime.Now.Ticks"></script>
}