@model CapaModelo.CMCompra

@{
    ViewBag.Title = "Detalles de Compra";
}

<div class="container-fluid px-4">

    <!-- Encabezado y Botones -->
    <div class="d-flex justify-content-between align-items-center mt-4">
        <h2 class="fw-bold">
            <i class="fas fa-shopping-cart me-2 text-primary"></i>
            Compra #@Model.id_compra
            @if (!string.IsNullOrEmpty(Model.Referencia))
            {
                <span class="text-muted fs-5">(@Model.Referencia)</span>
            }
        </h2>

        <div class="btn-group">
            @Html.ActionLink("Volver", "Index", null, new { @class = "btn btn-secondary" })

            @if (ViewBag.PuedeEditar != null && (bool)ViewBag.PuedeEditar && Model.Estado == "PENDIENTE")
            {
                @Html.ActionLink("Editar", "Edit", new { id = Model.id_compra }, new { @class = "btn btn-warning ms-1" })
            }

            <a href="@Url.Action("ImprimirComprobante", "Compra", new { id = Model.id_compra })"
               class="btn btn-outline-primary ms-1" target="_blank">
                <i class="fas fa-print me-1"></i> Imprimir Comprobante
            </a>
        </div>
    </div>

    <!-- Información de la Compra y Acciones -->
    <div class="row mt-4">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Información de la Compra</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="small text-muted">Proveedor</label>
                            <p class="fw-bold mb-0">@Model.NombreProveedor</p>
                            <small class="text-muted">@Model.DocumentoProveedor</small>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="small text-muted">Fecha de Compra</label>
                            <p class="fw-bold mb-0">@Model.FechaCompra.ToString("dd/MM/yyyy")</p>
                            <small class="text-muted">@Model.FechaCompra.ToString("hh:mm tt")</small>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="small text-muted">Estado</label>
                            <p class="mb-0">
                                @if (Model.Estado == "COMPLETADA")
                                {
                                    <span class="badge bg-success">COMPLETADA</span>
                                }
                                else if (Model.Estado == "PENDIENTE")
                                {
                                    <span class="badge bg-warning text-dark">PENDIENTE</span>
                                }
                                else if (Model.Estado == "MODIFICADA")
                                {
                                    <span class="badge bg-info">MODIFICADA</span>
                                }
                                else if (Model.Estado == "ANULADA")
                                {
                                    <span class="badge bg-danger">ANULADA</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@Model.Estado</span>
                                }
                            </p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="small text-muted">Tipo de Compra</label>
                            <p class="fw-bold mb-0">@Model.NombreTipoCompra</p>
                        </div>

                        <!-- Método de Pago Integrado -->
                        <div class="col-md-6 mb-3">
                            <label class="small text-muted">Método de Pago</label>
                            <p class="fw-bold mb-0">
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-2 py-1">
                                    <i class="fas fa-wallet me-1"></i>@(string.IsNullOrEmpty(Model.TipoPago) ? "No especificado" : Model.TipoPago)
                                </span>
                            </p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="small text-muted">Registrado por</label>
                            <p class="fw-bold mb-0">@Model.NombreUsuario</p>
                            <small class="text-muted">@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</small>
                        </div>

                        <div class="col-12 mt-2">
                            <hr class="my-2" />
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted fw-bold">Monto Total de la Transacción:</span>
                                <h4 class="text-primary fw-bold mb-0">Bs. @Model.MontoTotal.ToString("0.00")</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Acciones Operativas -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="fas fa-bolt me-2"></i>Acciones Operativas</h5>
                </div>
                <div class="card-body d-flex flex-column justify-content-center gap-2">
                    @if (Model.Estado == "PENDIENTE" && ViewBag.PuedeCompletar == true)
                    {
                        <a href="@Url.Action("Completar", "Compra", new { id = Model.id_compra })" class="btn btn-success py-2">
                            <i class="fas fa-check-circle me-1"></i> Completar Compra (Ingresar Stock)
                        </a>
                    }

                    @if (Model.Estado != "ANULADA" && ViewBag.PuedeAnular == true)
                    {
                        <a href="@Url.Action("Anular", "Compra", new { id = Model.id_compra })" class="btn btn-danger py-2">
                            <i class="fas fa-ban me-1"></i> Anular Compra
                        </a>
                    }

                    @if (Model.Estado == "ANULADA")
                    {
                        <div class="alert alert-danger mb-0">
                            <i class="fas fa-lock me-1"></i> Esta compra se encuentra <strong>ANULADA</strong> y no admite modificaciones operativas.
                        </div>
                    }
                    else if (Model.Estado == "COMPLETADA")
                    {
                        <div class="alert alert-success mb-0">
                            <i class="fas fa-check-double me-1"></i> Compra finalizada. El stock y el egreso ya están impactados en almacén.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Detalles de la Compra -->
    <div class="card shadow-sm border-0 mt-4 mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0"><i class="fas fa-list me-2"></i>Items Comprados</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th width="5%" class="text-center">#</th>
                            <th width="35%">Item</th>
                            <th width="10%" class="text-center">Tipo</th>
                            <th width="10%" class="text-center">Cantidad</th>
                            <th width="15%" class="text-end">Precio Unit.</th>
                            <th width="15%" class="text-end">Subtotal</th>
                            <th width="10%" class="text-center">Medida</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Detalles != null && Model.Detalles.Any())
                        {
                            var contador = 1;
                            foreach (var detalle in Model.Detalles)
                            {
                                <tr>
                                    <td class="text-center">@contador</td>
                                    <td>
                                        <strong>@detalle.NombreItem</strong>
                                        @if (!string.IsNullOrEmpty(detalle.DescripcionItem))
                                        {
                                            <br /><small class="text-muted">@detalle.DescripcionItem</small>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @(detalle.TipoItem == "PRODUCTO" ? "bg-info" : "bg-warning text-dark")">
                                            @detalle.TipoItem
                                        </span>
                                    </td>
                                    <td class="text-center fw-bold">@detalle.cantidad</td>
                                    <td class="text-end">Bs. @detalle.precioUnitario.ToString("0.00")</td>
                                    <td class="text-end fw-bold">Bs. @detalle.subtotal.ToString("0.00")</td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border">@detalle.MedidaItem</span>
                                    </td>
                                </tr>
                                contador++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    <i class="fas fa-info-circle me-2"></i> No hay detalles registrados para esta compra.
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="5" class="text-end fw-bold">TOTAL:</td>
                            <td class="text-end fw-bold fs-6 text-primary">Bs. @Model.MontoTotal.ToString("0.00")</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>