@model List<CapaModelo.CMCompra>

@{
    ViewBag.Title = "Listado de Compras";
}

<div class="container-fluid px-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mt-4">
        <h2 class="fw-bold"><i class="fas fa-shopping-cart me-2 text-primary"></i>Listado de Compras</h2>
    </div>

    <div class="mt-3">
        @if (ViewBag.PuedeCrear != null && (bool)ViewBag.PuedeCrear)
        {
            @Html.ActionLink("Nueva Compra", "Create", null, new { @class = "btn btn-primary shadow-sm" })
        }
    </div>

    <!-- Filtros Avanzados -->
    <div class="card shadow-sm border-0 mb-4 mt-3">
        <div class="card-body">
            <form method="get" action="@Url.Action("Index", "Compra")" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Referencia / Proveedor</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="fas fa-search"></i></span>
                        <input type="text" name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Buscar..." />
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="form-label small fw-bold">Estado</label>
                    <select name="estado" class="form-select">
                        <option value="">Todos los estados</option>
                        <option value="PENDIENTE" @(ViewBag.Estado == "PENDIENTE" ? "selected" : "")>PENDIENTE</option>
                        <option value="COMPLETADA" @(ViewBag.Estado == "COMPLETADA" ? "selected" : "")>COMPLETADA</option>
                        <option value="ANULADA" @(ViewBag.Estado == "ANULADA" ? "selected" : "")>ANULADA</option>
                        <option value="MODIFICADA" @(ViewBag.Estado == "MODIFICADA" ? "selected" : "")>MODIFICADA</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label small fw-bold">Desde</label>
                    <input type="date" name="fechaDesde" value="@ViewBag.FechaDesde" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label class="form-label small fw-bold">Hasta</label>
                    <input type="date" name="fechaHasta" value="@ViewBag.FechaHasta" class="form-control" />
                </div>

                <div class="col-md-12 mt-3 d-flex gap-2 justify-content-end">
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-filter me-1"></i> Filtrar
                    </button>
                    <a href="@Url.Action("Index", "Compra")" class="btn btn-secondary">
                        <i class="fas fa-undo me-1"></i> Limpiar
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center"># Compra</th>
                            <th>Proveedor</th>
                            <th class="text-center">Fecha</th>
                            <th class="text-end">Monto</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center">Usuario</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var compra in Model)
                            {
                                <tr>
                                    <td class="text-center fw-bold">
                                        @if (!string.IsNullOrEmpty(compra.Referencia))
                                        {
                                            @compra.Referencia
                                        }
                                        else
                                        {
                                            <span>#@compra.id_compra</span>
                                        }
                                    </td>

                                    <td>
                                        <div class="fw-semibold">@compra.NombreProveedor</div>
                                        <small class="text-muted">@compra.DocumentoProveedor</small>
                                    </td>

                                    <td class="text-center">
                                        @compra.FechaCompra.ToString("dd/MM/yyyy")
                                        <br />
                                        <small class="text-muted">@compra.FechaCompra.ToString("hh:mm tt")</small>
                                    </td>

                                    <td class="text-end fw-bold">
                                        Bs. @compra.MontoTotal.ToString("0.00")
                                    </td>

                                    <td class="text-center">
                                        @if (compra.Estado == "COMPLETADA")
                                        {
                                            <span class="badge bg-success">COMPLETADA</span>
                                        }
                                        else if (compra.Estado == "PENDIENTE")
                                        {
                                            <span class="badge bg-warning text-dark">PENDIENTE</span>
                                        }
                                        else if (compra.Estado == "ANULADA")
                                        {
                                            <span class="badge bg-danger">ANULADA</span>
                                        }
                                        else if (compra.Estado == "CANCELADA")
                                        {
                                            <span class="badge bg-secondary">CANCELADA</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info">@compra.Estado</span>
                                        }
                                    </td>

                                    <td class="text-center">
                                        <small>@compra.NombreUsuario</small>
                                    </td>

                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            @Html.ActionLink("Ver", "Details", new { id = compra.id_compra },
                                                new { @class = "btn btn-info btn-sm", title = "Ver detalles" })

                                            @if (ViewBag.PuedeEditar != null && (bool)ViewBag.PuedeEditar && compra.Estado == "PENDIENTE")
                                            {
                                                @Html.ActionLink("Editar", "Edit", "Compra", new { id = compra.id_compra }, new { @class = "btn btn-warning btn-sm" })
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4">
                                    <i class="fas fa-info-circle me-2 text-muted"></i>
                                    @if (!string.IsNullOrEmpty(ViewBag.Buscar) || !string.IsNullOrEmpty(ViewBag.Estado))
                                    {
                                        <span>No se encontraron compras con los filtros aplicados.</span>
                                    }
                                    else
                                    {
                                        <span>No hay compras registradas.</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>