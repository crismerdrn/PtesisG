@model CapaModelo.CMDashboardViewModel
@{
    ViewBag.Title = "Panel de Control";
}

<div class="container-fluid px-4 py-3">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm overflow-hidden" style="background: linear-gradient(135deg, #212529 0%, #15181b 100%); position: relative; border-radius: 1rem;">
                <div class="card-body p-4 text-white d-flex align-items-center justify-content-between position-relative" style="z-index: 2;">
                    <div>
                        <h2 class="fw-bold mb-1">¡Bienvenido, @(Session["Usuario"] != null ? ((CapaModelo.Usuario)Session["Usuario"]).nombre : "Administrador")!</h2>
                        <p class="m-0 text-white-50 small">Resumen de operaciones en tiempo real en <strong>@(ViewBag.NombrePolleria ?? "El Escondite del Loro")</strong>.</p>
                    </div>
                    <div class="d-none d-md-block text-end">
                        <span class="fs-5 d-block fw-bold text-success"><i class="fas fa-store me-2"></i>Sucursal Activa</span>
                        <small class="text-white-50">@(ViewBag.NombrePolleria ?? "Sucursal Principal")</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6 col-12">
            <div class="card border-0 shadow-sm border-start border-success border-4 h-100 p-3 card-hover" style="border-radius: 0.75rem;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-bold">VENTAS DE HOY</span>
                        <h3 class="fw-bold m-0 text-success mt-1">Bs. @Model.VentasHoy.ToString("N2")</h3>
                        <small class="text-success fw-semibold"><i class="fas fa-store-alt me-1"></i> Sucursal activa</small>
                    </div>
                    <div class="bg-success bg-opacity-10 p-3 rounded-3 text-success">
                        <i class="fa fa-shopping-basket fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 col-12">
            <div class="card border-0 shadow-sm border-start border-primary border-4 h-100 p-3 card-hover" style="border-radius: 0.75rem;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-bold">COMPRAS TOTALES DE HOY</span>
                        <h3 class="fw-bold m-0 text-primary mt-1">Bs. @Model.ComprasHoy.ToString("N2")</h3>
                        <small class="text-primary fw-semibold"><i class="fas fa-building me-1"></i> Abastecimiento central</small>
                    </div>
                    <div class="bg-primary bg-opacity-10 p-3 rounded-3 text-primary">
                        <i class="fa fa-truck-loading fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 col-12">
            <div class="card border-0 shadow-sm border-start border-warning border-4 h-100 p-3 card-hover position-relative" style="border-radius: 0.75rem;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-bold">ALERTAS DE STOCK</span>
                        <h3 class="fw-bold m-0 text-warning mt-1">@Model.ArticulosStockBajo Artículos</h3>
                        <small class="@(Model.ArticulosStockBajo > 0 ? "text-danger fw-bold" : "text-muted")">
                            <i class="fa fa-exclamation-triangle me-1"></i> @(Model.ArticulosStockBajo > 0 ? "Requiere reposición" : "Inventario óptimo")
                        </small>
                    </div>
                    <div class="bg-warning bg-opacity-10 p-3 rounded-3 text-warning">
                        <i class="fa fa-boxes fa-2x"></i>
                    </div>
                </div>
                <a href="@Url.Action("Index", "ReportStock", new { tipoFiltro = "BAJO" })" class="stretched-link" title="Ver alertas"></a>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 col-12">
            <div class="card border-0 shadow-sm border-start border-info border-4 h-100 p-3 card-hover" style="border-radius: 0.75rem;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-bold">PEDIDOS DE HOY</span>
                        <h3 class="fw-bold m-0 text-info mt-1">@Model.PedidosHoy</h3>
                        <small class="text-info fw-semibold"><i class="fas fa-receipt me-1"></i> Pedidos atendidos</small>
                    </div>
                    <div class="bg-info bg-opacity-10 p-3 rounded-3 text-info">
                        <i class="fa fa-clipboard-list fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <h5 class="fw-bold text-dark mb-3"><i class="fas fa-th-large text-success me-2"></i>Accesos Rápidos</h5>
        </div>
        <div class="col-md-3 col-sm-6 col-12 mb-3">
            <a href="@Url.Action("Create", "Venta")" class="btn btn-quick-access d-flex flex-column align-items-center justify-content-center p-4 w-100 shadow-sm border-0 bg-success text-white">
                <i class="fas fa-cash-register fa-2x mb-3"></i>
                <span class="fw-bold">Nueva Venta</span>
                <small class="text-white-50 text-center d-block mt-1" style="font-size: 0.75rem;">Registrar ventas</small>
            </a>
        </div>
        <div class="col-md-3 col-sm-6 col-12 mb-3">
            <a href="@Url.Action("Create", "Compra")" class="btn btn-quick-access d-flex flex-column align-items-center justify-content-center p-4 w-100 shadow-sm border-0 bg-primary text-white">
                <i class="fas fa-shopping-cart fa-2x mb-3"></i>
                <span class="fw-bold">Registrar Compra</span>
                <small class="text-white-50 text-center d-block mt-1" style="font-size: 0.75rem;">Producto e Insumos</small>
            </a>
        </div>
        <div class="col-md-3 col-sm-6 col-12 mb-3">
            <a href="@Url.Action("Index", "ReportStock")" class="btn btn-quick-access d-flex flex-column align-items-center justify-content-center p-4 w-100 shadow-sm border-0 bg-dark text-white">
                <i class="fas fa-warehouse fa-2x mb-3"></i>
                <span class="fw-bold">Ver Inventario</span>
                <small class="text-white-50 text-center d-block mt-1" style="font-size: 0.75rem;">Control de stock y alertas</small>
            </a>
        </div>
        <div class="col-md-3 col-sm-6 col-12 mb-3">
            <a href="@Url.Action("Index", "ReportVentas")" class="btn btn-quick-access d-flex flex-column align-items-center justify-content-center p-4 w-100 shadow-sm border-0 bg-secondary text-white">
                <i class="fas fa-chart-line fa-2x mb-3"></i>
                <span class="fw-bold">Reportes</span>
                <small class="text-white-50 text-center d-block mt-1" style="font-size: 0.75rem;">Auditoría de Ventas y Compras</small>
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6 col-12">
            <div class="card border-0 shadow-sm" style="border-radius: 0.75rem;">
                <div class="card-header bg-white border-0 py-3 d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="fw-bold text-dark m-0"><i class="fas fa-receipt text-success me-2"></i>Últimas Ventas</h5>
                        <small class="text-muted">Ventas registradas en @(ViewBag.NombrePolleria ?? "esta sucursal")</small>
                    </div>
                    <a href="@Url.Action("Index", "ReportVentas")" class="text-success text-decoration-none small fw-bold">Ver Todo &raquo;</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" style="font-size: 0.9rem;">
                            <thead class="table-light">
                                <tr>
                                    <th>N° Venta</th>
                                    <th>Cliente</th>
                                    <th>Canal</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.UltimasVentas != null && Model.UltimasVentas.Any())
                                {
                                    foreach (var v in Model.UltimasVentas)
                                    {
                                        <tr>
                                            <td><span class="fw-bold text-dark">@v.NumeroVenta</span></td>
                                            <td>@v.Cliente</td>
                                            <td><span class="badge bg-light text-dark border">@v.CanalVenta</span></td>
                                            <td class="text-end fw-bold text-success">Bs. @v.TotalVenta.ToString("N2")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-4">
                                            <i class="fas fa-cash-register d-block mb-2 text-secondary opacity-50" style="font-size: 1.5rem;"></i>
                                            No hay ventas registradas recientemente en esta sucursal.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6 col-12">
            <div class="card border-0 shadow-sm" style="border-radius: 0.75rem;">
                <div class="card-header bg-white border-0 py-3 d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="fw-bold text-dark m-0"><i class="fas fa-truck text-primary me-2"></i>Últimas Compras Generales</h5>
                        <small class="text-muted">Compras de insumos y productos a proveedores</small>
                    </div>
                    <a href="@Url.Action("Index", "ReportCompras")" class="text-primary text-decoration-none small fw-bold">Ver Todo &raquo;</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" style="font-size: 0.9rem;">
                            <thead class="table-light">
                                <tr>
                                    <th>N° Compra</th>
                                    <th>Proveedor</th>
                                    <th>Estado</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.UltimasCompras != null && Model.UltimasCompras.Any())
                                {
                                    foreach (var c in Model.UltimasCompras)
                                    {
                                        <tr>
                                            <td><span class="fw-bold text-dark">@c.NumeroCompra</span></td>
                                            <td>@c.Proveedor</td>
                                            <td><span class="badge @(c.Estado == "COMPLETADA" ? "bg-success bg-opacity-10 text-success" : "bg-secondary")">@c.Estado</span></td>
                                            <td class="text-end fw-bold text-dark">Bs. @c.TotalCompra.ToString("N2")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-4">
                                            <i class="fas fa-truck-loading d-block mb-2 text-secondary opacity-50" style="font-size: 1.5rem;"></i>
                                            No hay compras registradas recientemente en el sistema.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card-hover {
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

        .card-hover:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.08) !important;
        }

    .btn-quick-access {
        border-radius: 0.75rem;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        text-decoration: none;
    }

        .btn-quick-access:hover {
            transform: scale(1.03);
            box-shadow: 0 8px 18px rgba(0, 0, 0, 0.15) !important;
            opacity: 0.95;
        }
</style>