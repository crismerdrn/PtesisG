@model CapaModelo.CMReporteCompraViewModel
@{
    ViewBag.Title = "Reporte de Compras";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

<div class="container-fluid px-4 py-3">
    <!-- ENCABEZADO IMPRESIÓN -->
    <div class="print-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h5 class="m-0 fw-bold text-success">EL ESCONDITE DEL LORO</h5>
                <p class="m-0 small text-muted">Reporte Detallado de Compras</p>
            </div>
            <div class="text-end small">
                <div><b>Período:</b> @(DateTime.Parse(ViewBag.FechaInicio).ToString("dd/MM/yyyy")) al @(DateTime.Parse(ViewBag.FechaFin).ToString("dd/MM/yyyy"))</div>
                <div><b>Generado:</b> @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
        </div>
    </div>

    <!-- ENCABEZADO PANTALLA -->
    <div class="d-flex justify-content-between align-items-center mb-3 no-print">
        <div class="d-flex align-items-center gap-2">
            <h3 class="text-success m-0 fw-bold"><i class="fa fa-truck-loading me-2"></i>Reporte de Compras</h3>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-success btn-sm" onclick="exportarExcelCompras();">
                <i class="fa fa-file-excel me-1"></i> Excel
            </button>
            <button class="btn btn-outline-danger btn-sm" onclick="descargarPDFCompras();">
                <i class="fa fa-file-pdf me-1"></i> Imprimir Reporte
            </button>
        </div>
    </div>

    <!-- KPIs -->
    <div class="row g-3 mb-4 kpi-print-row">
        <div class="col-md-3 col-6">
            <div class="card card-kpi shadow-sm border-start border-success border-4 p-3 kpi-print-box">
                <span class="text-muted small">Total Invertido</span>
                <h4 class="text-success fw-bold m-0">Bs. @Model.TotalInvertido.ToString("N2")</h4>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card card-kpi shadow-sm border-start border-primary border-4 p-3 kpi-print-box">
                <span class="text-muted small">Cantidad Compras</span>
                <h4 class="text-primary fw-bold m-0">@Model.CantidadCompras</h4>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card card-kpi shadow-sm border-start border-info border-4 p-3 kpi-print-box">
                <span class="text-muted small">Compra Promedio</span>
                <h4 class="text-info fw-bold m-0">Bs. @Model.CompraPromedio.ToString("N2")</h4>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card card-kpi shadow-sm border-start border-warning border-4 p-3 kpi-print-box">
                <span class="text-muted small">Ítems Recibidos</span>
                <h4 class="text-warning fw-bold m-0">@Model.TotalItemsComprados.ToString("N2")</h4>
            </div>
        </div>
    </div>

    <!-- FILTROS -->
    <div class="card shadow-sm mb-4 border-0 no-print" style="background-color: #fdfdfd; border: 1px solid #e9ecef !important;">
        <div class="card-body p-3">
            @using (Html.BeginForm("Index", "ReportCompras", FormMethod.Get, new { @class = "row g-2 align-items-end" }))
            {
                <div class="col-lg-3 col-md-3">
                    <label class="form-label small fw-bold mb-1">Fecha Desde</label>
                    <input type="date" name="fechaInicio" class="form-control form-control-sm" value="@ViewBag.FechaInicio" />
                </div>
                <div class="col-lg-3 col-md-3">
                    <label class="form-label small fw-bold mb-1">Fecha Hasta</label>
                    <input type="date" name="fechaFin" class="form-control form-control-sm" value="@ViewBag.FechaFin" />
                </div>
                <div class="col-lg-3 col-md-3">
                    <label class="form-label small fw-bold mb-1">Proveedor</label>
                    @Html.DropDownList("idProveedor", (SelectList)ViewBag.ListaProveedores, "TODOS LOS PROVEEDORES", new { @class = "form-select form-select-sm" })
                </div>
                <div class="col-lg-3 col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-success btn-sm flex-grow-1">
                        <i class="fa fa-filter me-1"></i> Filtrar
                    </button>
                    <a href="@Url.Action("Index", "ReportCompras")" class="btn btn-outline-secondary btn-sm" title="Restablecer">Limpiar</a>
                </div>
            }
        </div>
    </div>

    <!-- TABLA -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="tablaCompras">
                    <thead>
                        <tr>
                            <th style="width: 15%;">N° Compra</th>
                            <th style="width: 18%;">Fecha</th>
                            <th>Proveedor</th>
                            <th>Registrado Por</th>
                            <th class="text-center" style="width: 10%;">Cant. Ítems</th>
                            <th class="text-end" style="width: 15%;">Total</th>
                            <th class="text-center col-estado" style="width: 12%;">Estado</th>
                            <th class="text-center no-print col-accion" style="width: 60px;">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Compras != null && Model.Compras.Any())
                        {
                            foreach (var item in Model.Compras)
                            {
                                <tr>
                                    <td class="fw-bold text-dark">@item.NumeroCompra</td>
                                    <td>
                                        <div>@item.FechaCompra.ToString("dd/MM/yyyy")</div>
                                        <small class="text-muted">@item.HoraCompra.ToString(@"hh\:mm")</small>
                                    </td>
                                    <td>@item.Proveedor</td>
                                    <td class="text-muted">@item.Comprador</td>
                                    <td class="text-center">@item.TotalItemsComprados.ToString("N2")</td>
                                    <td class="text-end fw-bold text-success">Bs. @item.TotalCompra.ToString("N2")</td>
                                    <td class="text-center col-estado">
                                        <span class="badge @(item.Estado.ToUpper() == "COMPLETADA" ? "bg-success" : "bg-secondary")">@item.Estado</span>
                                    </td>
                                    <td class="text-center no-print col-accion">
                                        <a href="@Url.Action("Details", "Compra", new { id = item.IdCompra })" class="btn btn-sm btn-outline-info p-1 px-2" title="Ver detalle">
                                            <i class="fa fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    <i class="fa fa-inbox fa-2x mb-2 d-block text-secondary"></i>
                                    No se encontraron compras en el período seleccionado.
                                </td>
                            </tr>
                        }
                    </tbody>
                    @if (Model.Compras != null && Model.Compras.Any())
                    {
                        <tfoot class="table-light fw-bold">
                            <tr>
                                <td colspan="4" class="text-end">TOTALES:</td>
                                <td class="text-center">@Model.TotalItemsComprados.ToString("N2")</td>
                                <td class="text-end text-success">Bs. @Model.TotalInvertido.ToString("N2")</td>
                                <td class="col-estado"></td>
                                <td class="no-print col-accion"></td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link href="@Url.Content("~/Content/Impresion.css")" rel="stylesheet" />
}

@section JavaScript {
    <script>
        function exportarExcelCompras() {
            var tabla = document.getElementById("tablaCompras");
            if (!tabla) return;
            var clon = tabla.cloneNode(true);
            clon.querySelectorAll('.col-accion').forEach(el => el.remove());

            var wb = XLSX.utils.table_to_book(clon, { sheet: "Compras", raw: false });
            XLSX.writeFile(wb, "Reporte_Compras_" + '@ViewBag.FechaInicio' + "_al_" + '@ViewBag.FechaFin' + ".xlsx");
        }

        function descargarPDFCompras() {
            var elemento = document.querySelector('.container-fluid');
            var ocultar = document.querySelectorAll('.no-print, .col-accion, .col-estado');
            ocultar.forEach(el => el.style.setProperty('display', 'none', 'important'));

            var header = document.querySelector('.print-header');
            if (header) header.style.setProperty('display', 'block', 'important');

            var opciones = {
                margin: [8, 8, 8, 8],
                filename: "Reporte_Compras_" + '@ViewBag.FechaInicio' + "_al_" + '@ViewBag.FechaFin' + ".pdf",
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2, useCORS: true },
                jsPDF: { unit: 'mm', format: 'letter', orientation: 'portrait' }
            };

            html2pdf().set(opciones).from(elemento).save().then(function () {
                ocultar.forEach(el => el.style.removeProperty('display'));
                if (header) header.style.removeProperty('display');
            });
        }
    </script>
}