@model CapaModelo.CMLogin
@{
    ViewBag.Title = "Acceso al Sistema - El Escondite del Loro";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>
    @Styles.Render("~/Content/css")
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        * {
            box-sizing: border-box;
        }

        html, body {
            min-height: 100vh;
            margin: 0;
            padding: 0;
            /* Fondo claro conservado */
            background-color: #eef2f6;
            background-image: radial-gradient(#dbe3ea 1px, transparent 1px);
            background-size: 24px 24px;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-wrapper {
            width: 100%;
            max-width: 880px;
            padding: 1.5rem;
        }

        .login-card {
            background-color: #ffffff;
            border-radius: 1.5rem;
            border: 1px solid rgba(0, 0, 0, 0.06);
            overflow: hidden;
            box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.12);
        }

        /* ---------------- PANEL IZQUIERDO: COLOR SIDEBAR + LOGO GRANDE + SOLO NOMBRE ---------------- */
        .brand-panel {
            background: linear-gradient(160deg, #212529 0%, #17191c 100%);
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: center; /* Centrado vertical absoluto */
            align-items: center; /* Centrado horizontal absoluto */
            padding: 3.5rem 2rem;
            text-align: center;
            overflow: hidden;
        }

            .brand-panel::before {
                content: "";
                position: absolute;
                top: -20%;
                left: -20%;
                width: 140%;
                height: 140%;
                background: radial-gradient(circle at 35% 30%, rgba(25, 135, 84, 0.18), transparent 60%);
                pointer-events: none;
            }

        .brand-content {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            width: 100%;
            z-index: 2;
        }

        /* Contenedor del Logo agrandado */
        .brand-logo-container {
            width: 165px;
            height: 165px;
            margin-bottom: 1.5rem;
            border-radius: 50%;
            padding: 6px;
            background: #ffffff;
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.45);
            display: flex;
            align-items: center;
            justify-content: center;
            transition: transform 0.3s ease;
        }

            .brand-logo-container:hover {
                transform: scale(1.03);
            }

            .brand-logo-container img {
                width: 100%;
                height: 100%;
                border-radius: 50%;
                object-fit: cover;
            }

        /* TÍTULO EN BLANCO BRILLANTE Y CENTRADO */
        .brand-title {
            color: #ffffff !important;
            font-weight: 800;
            letter-spacing: 1.5px;
            font-size: 1.35rem;
            line-height: 1.4;
            margin: 0;
            text-align: center;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.6);
        }

        /* ---------------- PANEL DERECHO (FORMULARIO) ---------------- */
        .form-panel {
            padding: 3.5rem 3rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
            background-color: #ffffff;
        }

        .form-header h3 {
            font-weight: 800;
            color: #1e293b;
            margin-bottom: 0.35rem;
            letter-spacing: -0.5px;
        }

        .form-header p {
            color: #64748b;
            font-size: 0.9rem;
            margin-bottom: 2rem;
        }

        .input-group-custom {
            border: 1.5px solid #cbd5e1;
            border-radius: 0.75rem;
            background-color: #f8fafc;
            transition: all 0.2s ease-in-out;
            overflow: hidden;
        }

            .input-group-custom:focus-within {
                border-color: #198754;
                background-color: #ffffff;
                box-shadow: 0 0 0 4px rgba(25, 135, 84, 0.12);
            }

            .input-group-custom .input-group-text {
                background-color: transparent;
                border: none;
                color: #64748b;
                padding-left: 1rem;
                padding-right: 0.5rem;
            }

            .input-group-custom .form-control {
                border: none;
                background-color: transparent;
                padding: 0.8rem 0.75rem;
                font-size: 0.95rem;
                color: #0f172a;
            }

                .input-group-custom .form-control:focus {
                    box-shadow: none;
                    outline: none;
                }

        .toggle-password {
            background: transparent;
            border: none;
            color: #94a3b8;
            padding-right: 1rem;
            cursor: pointer;
            transition: color 0.2s;
        }

            .toggle-password:hover {
                color: #198754;
            }

        .form-label {
            font-size: 0.8rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #475569;
            margin-bottom: 0.45rem;
        }

        .btn-login {
            background: linear-gradient(135deg, #198754 0%, #157347 100%);
            border: none;
            color: #ffffff;
            padding: 0.85rem;
            font-size: 1rem;
            font-weight: 700;
            border-radius: 0.75rem;
            letter-spacing: 0.3px;
            box-shadow: 0 10px 20px -5px rgba(25, 135, 84, 0.35);
            transition: all 0.25s ease;
        }

            .btn-login:hover {
                background: linear-gradient(135deg, #157347 0%, #0f5132 100%);
                transform: translateY(-2px);
                box-shadow: 0 14px 25px -5px rgba(25, 135, 84, 0.45);
                color: #ffffff;
            }

            .btn-login:active {
                transform: translateY(0);
            }

        .login-footer {
            margin-top: 2.25rem;
            text-align: center;
            font-size: 0.8rem;
            color: #94a3b8;
        }
    </style>
</head>
<body>
    <div class="login-wrapper">
        <div class="card login-card">
            <div class="row g-0">
                <!-- PANEL IZQUIERDO: SOLO LOGO GRANDE Y NOMBRE CENTRADO -->
                <div class="col-md-5 brand-panel d-none d-md-flex">
                    <div class="brand-content">
                        <div class="brand-logo-container">
                            <img src="@Url.Content("~/el loro.jpg")" alt="El Escondite del Loro" />
                        </div>
                        <h4 class="brand-title">EL ESCONDITE DEL LORO</h4>
                    </div>
                </div>

                <!-- PANEL DERECHO: FORMULARIO -->
                <div class="col-md-7 form-panel">
                    <div class="form-header">
                        <h3>Iniciar Sesión</h3>
                        <p>Ingrese sus credenciales autorizadas para acceder.</p>
                    </div>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 small mb-3 border-0 shadow-sm" })
                    }

                    @using (Html.BeginForm("Index", "Login", FormMethod.Post, new { autocomplete = "off" }))
                    {
                        @Html.AntiForgeryToken()

                        <!-- Usuario o Correo (Sin placeholder) -->
                        <div class="mb-3">
                            <label for="usuario" class="form-label">Usuario</label>
                            <div class="input-group input-group-custom">
                                <span class="input-group-text">
                                    <i class="fas fa-user"></i>
                                </span>
                                <input class="form-control"
                                       id="usuario"
                                       name="usuario"
                                       required
                                       value="@(Model?.usuario ?? "")" />
                            </div>
                            @Html.ValidationMessageFor(model => model.usuario, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <!-- Contraseña (Sin placeholder, solo muestra puntos al escribir y mantiene el ojo) -->
                        <div class="mb-4">
                            <label for="password" class="form-label">Contraseña</label>
                            <div class="input-group input-group-custom">
                                <span class="input-group-text">
                                    <i class="fas fa-lock"></i>
                                </span>
                                <input class="form-control"
                                       type="password"
                                       id="password"
                                       name="password"
                                       required />
                                <button type="button" class="toggle-password" onclick="togglePasswordVisibility()" tabindex="-1">
                                    <i class="fas fa-eye" id="eyeIcon"></i>
                                </button>
                            </div>
                            @Html.ValidationMessageFor(model => model.password, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <!-- Botón Submit -->
                        <div class="d-grid">
                            <button class="btn btn-login" type="submit">
                                <i class="fas fa-arrow-right-to-bracket me-2"></i> Acceder
                            </button>
                        </div>
                    }

                    <div class="login-footer">
                        &copy; @DateTime.Now.Year <strong>El Escondite del Loro</strong>. Todos los derechos reservados.
                    </div>
                </div>
            </div>
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    <script>
        function togglePasswordVisibility() {
            var passInput = document.getElementById("password");
            var icon = document.getElementById("eyeIcon");
            if (passInput.type === "password") {
                passInput.type = "text";
                icon.classList.remove("fa-eye");
                icon.classList.add("fa-eye-slash");
            } else {
                passInput.type = "password";
                icon.classList.remove("fa-eye-slash");
                icon.classList.add("fa-eye");
            }
        }
    </script>
</body>
</html>