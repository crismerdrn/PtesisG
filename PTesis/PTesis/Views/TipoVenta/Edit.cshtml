@model CapaModelo.CMTipoVenta

<div class="container-fluid px-4">
    <div class="card shadow-sm border-0 rounded-4 mt-4">
        <div class="card-header bg-warning text-dark rounded-top-4">
            <h4 class="mb-0"><i class="fas fa-edit me-2"></i>Editar Tipo de Venta</h4>
        </div>

        <div class="card-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.id_tipoVenta)
                @Html.HiddenFor(m => m.fecha_registro)
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-floating">
                            @Html.TextBoxFor(m => m.nombre, new { @class = "form-control", placeholder = "Nombre", required = "required" })
                            @Html.LabelFor(m => m.nombre)
                            @Html.ValidationMessageFor(m => m.nombre, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            @Html.TextBoxFor(m => m.descripcion, new { @class = "form-control", placeholder = "Descripción" })
                            @Html.LabelFor(m => m.descripcion)
                            @Html.ValidationMessageFor(m => m.descripcion, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <!-- Checkbox de Estado -->
                    <div class="col-md-12 mt-3">
                        <div class="form-check">
                            @Html.CheckBoxFor(m => m.estado, new { @class = "form-check-input", id = "estadoCheck" })
                            <label class="form-check-label" for "estadoCheck">
                                Tipo de Venta Activo
                            </label>
                            @Html.ValidationMessageFor(m => m.estado, "", new { @class = "text-danger small" })
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-start">
                    <button type="submit" class="btn btn-primary me-2">
                        <i class="fas fa-save me-1"></i> Actualizar
                    </button>
                    @Html.ActionLink("Volver al Listado", "Index", null, new { @class = "btn btn-secondary" })
                </div>
            }
        </div>
    </div>
</div>