@model CapaModelo.CMTipoVenta

<div class="container-fluid px-4">
    <div class="card shadow-sm border-0 rounded-4 mt-4">
        <div class="card-header bg-primary text-white rounded-top-4">
            <h4 class="mb-0"><i class="fas fa-store me-2"></i>Agregar Tipo de Venta</h4>
        </div>

        <div class="card-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-floating">
                            @Html.TextBoxFor(m => m.nombre, new { @class = "form-control", placeholder = "Nombre", required = "required" })
                            @Html.LabelFor(m => m.nombre)
                            @Html.ValidationMessageFor(m => m.nombre, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            @Html.TextBoxFor(m => m.descripcion, new { @class = "form-control", placeholder = "Descripción" })
                            @Html.LabelFor(m => m.descripcion)
                            @Html.ValidationMessageFor(m => m.descripcion, "", new { @class = "text-danger small" })
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-start">
                    <button type="submit" class="btn btn-success me-2">
                        <i class="fas fa-save me-1"></i> Guardar
                    </button>
                    @Html.ActionLink("Volver", "Index", null, new { @class = "btn btn-secondary" })
                </div>
            }
        </div>
    </div>
</div>