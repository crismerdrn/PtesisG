@model List<CapaModelo.CMMovimientoStock>
@{
    ViewBag.Title = "Historial de Movimientos de Stock";
    var pollerias = ViewBag.Pollerias as List<SelectListItem> ?? new List<SelectListItem>();
    var tiposItems = ViewBag.TiposItems as List<SelectListItem> ?? new List<SelectListItem>();
    var tiposMovimiento = ViewBag.TiposMovimiento as List<SelectListItem> ?? new List<SelectListItem>();
    string tipoItemSel = ViewBag.TipoItemSeleccionado as string;
    string tipoMovSel = ViewBag.TipoMovimientoSeleccionado as string;
    var movimientos = Model ?? new List<CapaModelo.CMMovimientoStock>();
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-start mt-4 mb-3">
        <div>
            <h2 class="fw-bold"><i class="fas fa-history me-2 text-primary"></i>Historial de Movimientos</h2>
            <p class="text-muted">Entradas, salidas, ajustes y transferencias de stock</p>
        </div>
        <a href="@Url.Action("Productos", "Stock")" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i>Volver</a>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            @using (Html.BeginForm("Historial", "Stock", FormMethod.Get, new { @class = "row g-3 align-items-end" }))
            {
                <div class="col-md-3">
                    <label class="form-label fw-bold">Pollería</label>
                    <select name="id_polleria" class="form-select">
                        <option value="">Todas</option>
                        @foreach (var p in pollerias)
                        {
                            <option value="@p.Value" selected="@p.Selected">@p.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold">Tipo de ítem</label>
                    <select name="tipo_item" class="form-select">
                        @foreach (var t in tiposItems)
                        {
                            <option value="@t.Value" selected="@(t.Value == (tipoItemSel ?? ""))">@t.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold">Movimiento</label>
                    <select name="tipo_movimiento" class="form-select">
                        @foreach (var t in tiposMovimiento)
                        {
                            <option value="@t.Value" selected="@(t.Value == (tipoMovSel ?? ""))">@t.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold">Desde</label>
                    <input type="date" name="fecha_desde" class="form-control" value="@ViewBag.FechaDesde" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold">Hasta</label>
                    <input type="date" name="fecha_hasta" class="form-control" value="@ViewBag.FechaHasta" />
                </div>
                <div class="col-md-1 d-grid">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-filter"></i></button>
                </div>
            }
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            @if (!movimientos.Any())
            {
                <div class="alert alert-info mb-0"><i class="fas fa-info-circle me-2"></i>No se encontraron movimientos con los filtros seleccionados.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-sm align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Fecha</th>
                                <th>Movimiento</th>
                                <th>Ítem</th>
                                <th>Tipo</th>
                                <th>Pollería</th>
                                <th class="text-end">Cantidad</th>
                                <th class="text-end">Stock anterior</th>
                                <th class="text-end">Stock nuevo</th>
                                <th>Usuario</th>
                                <th>Observaciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in movimientos)
                            {
                                <tr>
                                    <td>@m.fecha_movimiento.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td><span class="badge bg-secondary">@m.tipo_movimiento</span></td>
                                    <td>@m.nombre_item</td>
                                    <td>@m.tipo_item</td>
                                    <td>@m.nombre_polleria</td>
                                    <td class="text-end">@m.cantidad.ToString("N2")</td>
                                    <td class="text-end">@m.stock_anterior.ToString("N2")</td>
                                    <td class="text-end fw-bold">@m.stock_nuevo.ToString("N2")</td>
                                    <td>@m.nombre_usuario</td>
                                    <td>@m.observaciones</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

</div>
