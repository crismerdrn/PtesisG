@model List<CapaModelo.CMMovimientoStock>
@{
    ViewBag.Title = "Kardex de Producto";
    var movimientos = Model ?? new List<CapaModelo.CMMovimientoStock>();
}

<div class="container-fluid px-4">
    <div class="mt-4 mb-3">
        <h2 class="fw-bold"><i class="fas fa-book me-2 text-primary"></i>Kardex: @ViewBag.ProductoNombre</h2>
        <p class="text-muted">Pollería: @ViewBag.PolleriaNombre</p>
    </div>

    <div class="row mb-3">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm"><div class="card-body">
                <small class="text-muted">Stock actual</small>
                <div class="fs-4 fw-bold">@(((decimal)ViewBag.StockActual).ToString("N2"))</div>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm"><div class="card-body">
                <small class="text-muted">Stock mínimo</small>
                <div class="fs-4 fw-bold">@(((decimal)ViewBag.StockMinimo).ToString("N2"))</div>
            </div></div>
        </div>
        <div class="col-md-6">
            @using (Html.BeginForm("Kardex", "Stock", FormMethod.Get, new { @class = "row g-2 align-items-end" }))
            {
                <input type="hidden" name="id_producto" value="@ViewBag.IdProducto" />
                <input type="hidden" name="id_polleria" value="@ViewBag.IdPolleria" />
                <div class="col-5">
                    <label class="form-label fw-bold">Desde</label>
                    <input type="date" name="fecha_desde" class="form-control" value="@ViewBag.FechaDesde" />
                </div>
                <div class="col-5">
                    <label class="form-label fw-bold">Hasta</label>
                    <input type="date" name="fecha_hasta" class="form-control" value="@ViewBag.FechaHasta" />
                </div>
                <div class="col-2 d-grid">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-filter"></i></button>
                </div>
            }
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            @if (!movimientos.Any())
            {
                <div class="alert alert-info mb-0"><i class="fas fa-info-circle me-2"></i>No hay movimientos registrados para este producto en el período seleccionado.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-sm align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Fecha</th>
                                <th>Movimiento</th>
                                <th>Referencia</th>
                                <th class="text-end">Cantidad</th>
                                <th class="text-end">Stock anterior</th>
                                <th class="text-end">Saldo</th>
                                <th>Usuario</th>
                                <th>Observaciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in movimientos)
                            {
                                <tr>
                                    <td>@m.fecha_movimiento.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td><span class="badge bg-secondary">@m.tipo_movimiento</span></td>
                                    <td>@m.tipo_referencia @(m.id_referencia.HasValue ? "#" + m.id_referencia : "")</td>
                                    <td class="text-end">@m.cantidad.ToString("N2")</td>
                                    <td class="text-end">@m.stock_anterior.ToString("N2")</td>
                                    <td class="text-end fw-bold">@m.stock_nuevo.ToString("N2")</td>
                                    <td>@m.nombre_usuario</td>
                                    <td>@m.observaciones</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <a href="@Url.Action("Productos", "Stock")" class="btn btn-secondary mb-4"><i class="fas fa-arrow-left me-1"></i>Volver</a>
</div>
