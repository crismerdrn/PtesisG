@{
    ViewBag.Title = "Configurar Stock Mínimo";
    string tipo = ViewBag.Tipo as string ?? "producto";
    bool esProducto = tipo == "producto";
}

<div class="container-fluid px-4">
    <div class="mt-4">
        <h2 class="fw-bold"><i class="fas fa-cog me-2 text-warning"></i>Configurar Stock Mínimo</h2>
        <p class="text-muted">Defina el nivel mínimo de stock para generar alertas de stock bajo</p>
    </div>

    @using (Html.BeginForm("ConfigurarMinimo", "Stock", FormMethod.Post, new { id = "formConfigurarMinimo" }))
    {
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@ViewBag.Id" />
        <input type="hidden" name="tipo" value="@tipo" />

        <div class="card shadow-sm border-0 mb-4" style="max-width: 720px;">
            <div class="card-header bg-light">
                <h5 class="card-title mb-0"><i class="fas fa-info-circle me-2"></i>@(esProducto ? "Producto" : "Insumo")</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">@(esProducto ? "Producto" : "Insumo"):</label>
                        <div class="form-control bg-light">@ViewBag.ItemNombre</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Pollería:</label>
                        <div class="form-control bg-light">@ViewBag.PolleriaNombre</div>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Stock Actual:</label>
                        <div class="form-control bg-light">@(((decimal)ViewBag.StockActual).ToString("N2")) @ViewBag.Abreviatura</div>
                    </div>
                    <div class="col-md-6">
                        <label for="stock_minimo" class="form-label fw-bold">Nuevo Stock Mínimo: <span class="text-danger">*</span></label>
                        <input type="number" id="stock_minimo" name="stock_minimo" class="form-control" min="0" step="0.01" required
                               value="@(((decimal)ViewBag.StockMinimo).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))" />
                        <div class="invalid-feedback">Ingrese un valor mayor o igual a 0.</div>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-white d-flex justify-content-end gap-2">
                <a href="@Url.Action(esProducto ? "Productos" : "Insumos", "Stock")" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-1"></i>Cancelar
                </a>
                <button type="submit" class="btn btn-warning">
                    <i class="fas fa-save me-1"></i>Guardar
                </button>
            </div>
        </div>
    }
</div>

@section JavaScript {
    <script>
        document.getElementById('formConfigurarMinimo').addEventListener('submit', function (e) {
            var input = document.getElementById('stock_minimo');
            var valor = parseFloat(input.value);
            if (isNaN(valor) || valor < 0) {
                e.preventDefault();
                input.classList.add('is-invalid');
            } else {
                input.classList.remove('is-invalid');
            }
        });
    </script>
}
