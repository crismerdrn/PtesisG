@model CapaModelo.CMPermisos

@{
    ViewBag.Title = "Eliminar Permiso";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card shadow-sm border-0 mt-4 border-danger">
    <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center py-3">
        <h5 class="mb-0"><i class="fas fa-exclamation-triangle me-2"></i>Confirmar Eliminación</h5>
    </div>
    <div class="card-body p-4">

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                <i class="fas fa-times-circle me-2"></i>@TempData["Error"]
            </div>
        }

        <h4 class="text-danger fw-bold mb-4">¿Está completamente seguro de eliminar este registro?</h4>

        <div class="row bg-light p-3 rounded mb-4">
            <dl class="row mb-0">
                <dt class="col-sm-3 text-muted">Nombre del Permiso:</dt>
                <dd class="col-sm-9 fw-bold fs-5">@Model.NombreMenu</dd>

                <dt class="col-sm-3 text-muted">Módulo:</dt>
                <dd class="col-sm-9">@Model.Modulo</dd>

                <dt class="col-sm-3 text-muted">Tipo:</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-secondary">@Model.Tipo</span>
                </dd>
            </dl>
        </div>

        @using (Html.BeginForm("Delete", "Permisos", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.HiddenFor(m => m.id_permiso)

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger btn-lg">
                    <i class="fas fa-trash-alt me-2"></i>Sí, Eliminar Definitivamente
                </button>
                <a href="@Url.Action("Mantenimiento", "Permisos")" class="btn btn-secondary btn-lg">
                    <i class="fas fa-times me-2"></i>Cancelar
                </a>
            </div>
        }
    </div>
</div>