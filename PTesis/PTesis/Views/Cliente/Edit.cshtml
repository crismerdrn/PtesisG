@model CapaModelo.CMClientes

<div class="container-fluid px-4">
    <div class="card shadow-sm border-0 rounded-4 mt-4">
        <div class="card-header bg-warning rounded-top-4">
            <h4 class="mb-0 text-dark"><i class="fas fa-user-edit me-2"></i>Modificar Datos de Cliente</h4>
        </div>

        <div class="card-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.id_cliente)

                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-floating">
                            @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", required = "required", placeholder = "Nombre" })
                            @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger small" })
                            <label>Nombre *</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            @Html.TextBoxFor(m => m.Apellido, new { @class = "form-control", required = "required", placeholder = "Apellido" })
                            @Html.ValidationMessageFor(m => m.Apellido, "", new { @class = "text-danger small" })
                            <label>Apellido *</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            @Html.TextBoxFor(m => m.Telefono, new { @class = "form-control", required = "required", placeholder = "Teléfono" })
                            @Html.ValidationMessageFor(m => m.Telefono, "", new { @class = "text-danger small" })
                            <label>Teléfono *</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "Email" })
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                            <label>Email (Opcional)</label>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-floating">
                            @Html.TextBoxFor(m => m.Direccion, new { @class = "form-control", placeholder = "Dirección" })
                            <label>Dirección (Opcional)</label>
                        </div>
                    </div>
                    <div class="col-md-12 mt-3">
                        <div class="form-check form-switch">
                            @Html.CheckBoxFor(m => m.Estado, new { @class = "form-check-input", role = "switch", id = "estadoCliente" })
                            <label class="form-check-label" for="estadoCliente">Cliente Activo</label>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />
                <div class="d-flex justify-content-start">
                    <button type="submit" class="btn btn-primary me-2">
                        <i class="fas fa-save me-1"></i> Actualizar Cambios
                    </button>
                    @Html.ActionLink("Volver", "Index", null, new { @class = "btn btn-secondary" })
                </div>
            }
        </div>
    </div>
</div>

@section JavaScript {
    @Scripts.Render("~/bundles/jqueryval")
}