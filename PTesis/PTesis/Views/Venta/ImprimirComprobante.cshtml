@model CapaModelo.CMVenta

@{
    Layout = null;
    bool esTicket = ViewBag.Tipo == "TICKET";
    string nombreEmpresa = string.IsNullOrWhiteSpace(Model.NombrePolleria) ? "Pollería" : Model.NombrePolleria;
    string titulo = esTicket ? "Ticket de Venta" : "Comprobante de Venta";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@titulo @Model.NumeroVenta</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { background: #f5f5f5; padding: 20px; color: #222; font-family: 'Segoe UI', Tahoma, Arial, sans-serif; }
        .doc { margin: 0 auto; background: #fff; }
        .comprobante { max-width: 800px; padding: 30px; border-radius: 8px; box-shadow: 0 0 15px rgba(0,0,0,.1); }
        .ticket { width: 80mm; padding: 4mm; font-family: 'Courier New', monospace; font-size: 12px; }
        .centro { text-align: center; }
        .derecha { text-align: right; }
        .empresa { font-size: 22px; font-weight: bold; }
        .ticket .empresa { font-size: 15px; }
        .sub { color: #555; font-size: 13px; }
        .ticket .sub { font-size: 11px; color: #000; }
        .titulo { margin: 14px 0; padding: 8px; background: #ecf0f1; font-size: 18px; font-weight: bold; text-align: center; }
        .ticket .titulo { background: none; padding: 0; margin: 6px 0; font-size: 13px; }
        .sep { border-top: 1px dashed #000; margin: 6px 0; }
        .datos { width: 100%; margin-bottom: 12px; }
        .datos td { padding: 3px 0; vertical-align: top; }
        .datos td.etq { font-weight: bold; width: 35%; }
        .detalle { width: 100%; border-collapse: collapse; margin: 10px 0; }
        .detalle th { text-align: left; border-bottom: 2px solid #2c3e50; padding: 6px 4px; }
        .detalle td { border-bottom: 1px solid #ddd; padding: 6px 4px; }
        .detalle .derecha { text-align: right; }
        .ticket .detalle th, .ticket .detalle td { border-bottom: none; padding: 2px 0; }
        .ticket .detalle th { border-bottom: 1px dashed #000; }
        .total { font-size: 18px; font-weight: bold; text-align: right; margin-top: 8px; }
        .ticket .total { font-size: 14px; }
        .anulada { color: #c0392b; font-weight: bold; text-align: center; font-size: 16px; margin: 8px 0; }
        .pie { margin-top: 18px; text-align: center; font-size: 12px; color: #555; }
        .acciones { text-align: center; margin: 20px 0; }
        .acciones button { padding: 8px 18px; margin: 0 4px; cursor: pointer; }
        @@media print {
            body { background: #fff; padding: 0; }
            .comprobante { box-shadow: none; border-radius: 0; }
            .acciones { display: none; }
            @(esTicket ? Html.Raw("@page { size: 80mm 297mm; margin: 0; }") : Html.Raw("@page { margin: 15mm; }"))
        }
    </style>
</head>
<body>
    <div class="doc @(esTicket ? "ticket" : "comprobante")">
        <div class="centro">
            <div class="empresa">@nombreEmpresa</div>
            @if (!string.IsNullOrWhiteSpace(Model.DireccionPolleria))
            {
                <div class="sub">@Model.DireccionPolleria</div>
            }
        </div>

        @if (esTicket)
        {
            <div class="sep"></div>
        }
        <div class="titulo">@titulo.ToUpper() N° @Model.NumeroVenta</div>

        @if (Model.Estado == "ANULADA")
        {
            <div class="anulada">*** VENTA ANULADA ***</div>
        }

        <table class="datos">
            <tr><td class="etq">Fecha:</td><td>@Model.Fecha_venta.ToString("dd/MM/yyyy") @Model.hora_venta.ToString(@"hh\:mm")</td></tr>
            <tr><td class="etq">Cliente:</td><td>@(string.IsNullOrWhiteSpace(Model.NombreCliente) ? "Cliente General" : Model.NombreCliente)</td></tr>
            @if (!esTicket && !string.IsNullOrWhiteSpace(Model.TelefonoCliente))
            {
                <tr><td class="etq">Teléfono:</td><td>@Model.TelefonoCliente</td></tr>
            }
            <tr><td class="etq">Atendido por:</td><td>@Model.NombreVendedor</td></tr>
            <tr><td class="etq">Forma de pago:</td><td>@Model.TipoPago</td></tr>
            @if (!string.IsNullOrWhiteSpace(Model.NombreTipoVenta))
            {
                <tr><td class="etq">Canal:</td><td>@Model.NombreTipoVenta</td></tr>
            }
        </table>

        <table class="detalle">
            <thead>
                <tr>
                    <th>Cant.</th>
                    <th>Producto</th>
                    @if (!esTicket)
                    {
                        <th class="derecha">P. Unit.</th>
                    }
                    <th class="derecha">Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Detalles ?? new List<CapaModelo.CMDetalleVenta>())
                {
                    <tr>
                        <td>@d.cantidad.ToString("0.##")</td>
                        <td>
                            @d.NombreProducto
                            @if (esTicket)
                            {
                                <br /><small>@d.cantidad.ToString("0.##") x @d.precio_unitario.ToString("0.00")</small>
                            }
                        </td>
                        @if (!esTicket)
                        {
                            <td class="derecha">Bs. @d.precio_unitario.ToString("0.00")</td>
                        }
                        <td class="derecha">Bs. @d.subtotal.ToString("0.00")</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (esTicket)
        {
            <div class="sep"></div>
        }
        <div class="total">TOTAL: Bs. @Model.Total_venta.ToString("0.00")</div>

        <div class="pie">
            <p>¡Gracias por su preferencia!</p>
            <p>Este documento no es una factura.</p>
            <p>Impreso: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
        </div>
    </div>

    <div class="acciones">
        <button type="button" onclick="window.print()">Imprimir</button>
        <button type="button" onclick="window.close()">Cerrar</button>
    </div>

    <script>
        window.addEventListener('load', function () {
            if (@(esTicket ? "true" : "false")) {
                var doc = document.querySelector('.doc');
                var altoMm = Math.ceil(doc.getBoundingClientRect().height * 25.4 / 96) + 10;
                var estilo = document.createElement('style');
                estilo.textContent = '@@media print { @@page { size: 80mm ' + altoMm + 'mm; margin: 0; } }';
                document.head.appendChild(estilo);
            }
            setTimeout(function () { window.print(); }, 300);
        });
    </script>
</body>
</html>
