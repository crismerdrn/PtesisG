@model List<CapaDatos.CMProductoStock>

@{
    ViewBag.Title = "Stock Disponible";
}

<div class="container-fluid px-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mt-4">
        <h2 class="fw-bold"><i class="fas fa-boxes me-2 text-info"></i>Stock Disponible</h2>
        <div>
            @if (ViewBag.PuedeAjustarStock == true)
            {
                @Html.ActionLink("Transferir Stock", "TransferirStock", null, new { @class = "btn btn-outline-primary me-2" })
                @Html.ActionLink("Ajustar Stock", "AjustarStock", null, new { @class = "btn btn-outline-warning" })
            }
        </div>
    </div>

    <!-- Filtros -->
    <div class="card shadow-sm border-0 mb-4 mt-3">
        <div class="card-body">
            <form method="get" action="@Url.Action("StockDisponible", "Venta")" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small fw-bold">Pollería</label>
                    @Html.DropDownList("idPolleria", ViewBag.ListaPollerias as SelectList,
                        new { @class = "form-select" })
                </div>

                <div class="col-md-4">
                    <label class="form-label small fw-bold"></label>
                    <div class="form-check mt-3">
                        <input class="form-check-input" type="checkbox" id="soloConStock"
                               name="soloConStock" value="true"
                               @(ViewBag.SoloConStock == true || !ViewBag.SoloConStock.HasValue ? "checked" : "") />
                        <label class="form-check-label" for="soloConStock">
                            Solo productos con stock disponible
                        </label>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-filter me-1"></i> Filtrar
                        </button>
                        <a href="@Url.Action("StockDisponible", "Venta")" class="btn btn-secondary">
                            <i class="fas fa-undo me-1"></i> Limpiar
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Resumen de Stock -->
    @if (Model != null && Model.Any())
    {
        var totalProductos = Model.Count;
        var conStock = Model.Count(p => p.StockActual > 0);
        var bajoStock = Model.Count(p => p.StockActual <= p.StockMinimo && p.StockActual > 0);
        var agotados = Model.Count(p => p.StockActual == 0);

        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card bg-primary text-white">
                    <div class="card-body text-center">
                        <h4 class="mb-0">@totalProductos</h4>
                        <small>Productos Totales</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-success text-white">
                    <div class="card-body text-center">
                        <h4 class="mb-0">@conStock</h4>
                        <small>Con Stock</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-warning text-white">
                    <div class="card-body text-center">
                        <h4 class="mb-0">@bajoStock</h4>
                        <small>Stock Bajo</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-danger text-white">
                    <div class="card-body text-center">
                        <h4 class="mb-0">@agotados</h4>
                        <small>Agotados</small>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Producto</th>
                            <th class="text-center">Tipo</th>
                            <th class="text-center">Stock Actual</th>
                            <th class="text-center">Stock Mínimo</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center">Último Movimiento</th>
                            <th class="text-center">Precio Venta</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var producto in Model)
                            {
                                <tr class="@producto.ClaseCSS">
                                    <td>
                                        <strong>@producto.NombreProducto</strong>
                                        <br />
                                        <small class="text-muted">@producto.Descripcion</small>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-info">@producto.TipoProducto</span>
                                    </td>
                                    <td class="text-center fw-bold">
                                        @producto.StockActual @producto.Abreviatura
                                    </td>
                                    <td class="text-center">
                                        @producto.StockMinimo @producto.Abreviatura
                                    </td>
                                    <td class="text-center">
                                        @if (producto.EstadoStock == "DISPONIBLE")
                                        {
                                            <span class="badge bg-success">@producto.EstadoStock</span>
                                        }
                                        else if (producto.EstadoStock == "BAJO")
                                        {
                                            <span class="badge bg-warning text-dark">@producto.EstadoStock</span>
                                        }
                                        else if (producto.EstadoStock == "AGOTADO")
                                        {
                                            <span class="badge bg-danger">@producto.EstadoStock</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@producto.EstadoStock</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <small>@(producto.FechaUltimoMovimiento != DateTime.MinValue ? producto.FechaUltimoMovimiento.ToString("dd/MM/yyyy HH:mm") : "Sin movimientos")</small>
                                    </td>
                                    <td class="text-end">
                                        Bs. @producto.PrecioVenta.ToString("0.00")
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            @if (ViewBag.PuedeAjustarStock == true)
                                            {
                                                @Html.ActionLink("Ajustar", "AjustarStock",
                                                    new { idProducto = producto.IdProducto, idPolleria = producto.IdPolleria },
                                                    new { @class = "btn btn-warning btn-sm", title = "Ajustar stock" })

                                                @Html.ActionLink("Transferir", "TransferirStock",
                                                    null,
                                                    new { @class = "btn btn-info btn-sm ms-1", title = "Transferir a otra pollería" })
                                            }
                                            @Html.ActionLink("Historial", "ReporteMovimientosStock",
                                                new { idItem = producto.IdProducto, tipoItem = "PRODUCTO" },
                                                new { @class = "btn btn-secondary btn-sm ms-1", title = "Ver historial" })
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4">
                                    <i class="fas fa-info-circle me-2 text-muted"></i>
                                    No hay productos con stock disponible
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>