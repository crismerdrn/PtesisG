@model CapaModelo.CMPolleria

<div class="container-fluid px-4">
    <div class="card shadow-sm border-danger rounded-4 mt-4">
        <div class="card-header bg-danger text-white rounded-top-4">
            <h4 class="mb-0"><i class="fas fa-trash-alt me-2"></i>Confirmar Eliminación</h4>
        </div>

        <div class="card-body">
            <h5 class="text-danger mb-4">¿Está seguro que desea eliminar la pollería <strong>@Model.Nombre</strong>?</h5>

            <div class="alert alert-warning">
                <i class="fas fa-exclamation-triangle me-2"></i>
                <strong>Importante:</strong> Si la pollería tiene movimientos de stock asociados, se desactivará en lugar de eliminarse.
            </div>

            @using (Html.BeginForm("Delete", "Polleria", new { id = Model.id_polleria }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.id_polleria)

                <dl class="row">
                    <dt class="col-sm-3">Nombre</dt>
                    <dd class="col-sm-9">@Model.Nombre</dd>

                    <dt class="col-sm-3">Dirección</dt>
                    <dd class="col-sm-9">@Model.Direccion</dd>

                    <dt class="col-sm-3">Teléfono</dt>
                    <dd class="col-sm-9">@Model.Telefono</dd>

                    <dt class="col-sm-3">Estado</dt>
                    <dd class="col-sm-9">
                        @if (Model.Estado)
                        {
                            <span class="badge bg-success">Activa</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactiva</span>
                        }
                    </dd>

                    <dt class="col-sm-3">Fecha Registro</dt>
                    <dd class="col-sm-9">@Model.FechaRegistro.ToString("dd/MM/yyyy")</dd>
                </dl>

                <hr class="my-4" />

                <div class="d-flex justify-content-start">
                    <button type="submit" class="btn btn-danger me-2">
                        <i class="fas fa-check-circle me-1"></i> Confirmar Eliminación
                    </button>
                    @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-secondary" })
                </div>
            }
        </div>
    </div>
</div>