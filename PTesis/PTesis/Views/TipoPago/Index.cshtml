@model List<CapaModelo.CMTipoPago>

<div class="container-fluid px-4">
    <!-- Título -->
    <div class="mt-4">
        <h2 class="fw-bold"><i class="fas fa-credit-card me-2 text-primary"></i>Listado de Tipos de Pago</h2>
    </div>

    <!-- Botón Agregar Tipo de Pago -->
    @if (ViewBag.PuedeCrear == true)
    {
        <div class="mb-3">
            @Html.ActionLink("Agregar Tipo de Pago", "Create", null, new { @class = "btn btn-primary shadow-sm" })
        </div>
    }

    <!-- Tarjeta de búsqueda -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form method="get" action="@Url.Action("Index", "TipoPago")" class="row g-2 align-items-center">
                <div class="col-md-9 col-lg-10">
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="fas fa-search"></i></span>
                        <input type="text" name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Buscar por descripción..." />
                    </div>
                </div>
                <div class="col-md-3 col-lg-2 d-flex gap-2 justify-content-end">
                    <button type="submit" class="btn btn-success w-50"><i class="fas fa-search me-1"></i> Buscar</button>
                    <a href="@Url.Action("Index", "TipoPago")" class="btn btn-secondary w-50"><i class="fas fa-undo me-1"></i> Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla de tipos de pago -->
    <div class="table-responsive shadow-sm rounded-4">
        <table class="table table-bordered table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var tipoPago in Model)
                    {
                        <tr>
                            <td>@tipoPago.nombre</td>
                            <td>@tipoPago.descripcion</td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    @if (ViewBag.PuedeEditar == true)
                                    {
                                        @Html.ActionLink("Editar", "Edit", new { id = tipoPago.id_tipoPago }, new { @class = "btn btn-warning btn-sm" })
                                    }
                                    @if (ViewBag.PuedeEliminar == true)
                                    {
                                        @Html.ActionLink("Eliminar", "Delete", new { id = tipoPago.id_tipoPago }, new { @class = "btn btn-danger btn-sm ms-1" })
                                    }
                                    @if (ViewBag.PuedeEditar != true && ViewBag.PuedeEliminar != true)
                                    {
                                        <span class="text-muted small">Solo lectura</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted py-4">
                            <i class="fas fa-inbox fa-2x mb-2"></i><br />
                            @if (!string.IsNullOrEmpty(ViewBag.Buscar))
                            {
                                <text>No se encontraron tipos de pago para "@ViewBag.Buscar"</text>
                            }
                            else
                            {
                                <text>No se encontraron tipos de pago</text>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>