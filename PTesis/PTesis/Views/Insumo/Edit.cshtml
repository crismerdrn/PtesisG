@model CapaModelo.CMInsumo

@{
    ViewBag.Title = "Editar Insumo";
}

<div class="container-fluid px-4">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>
            Por favor, corrija los errores en el formulario.
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-4 mt-4">
        <div class="card-header bg-warning text-dark rounded-top-4">
            <h4 class="mb-0"><i class="fas fa-edit me-2"></i>Editar Insumo</h4>
        </div>

        <div class="card-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.id_insumo)

                <div class="row g-3">

                    <div class="col-md-8">
                        <div class="form-floating">
                            @Html.TextBoxFor(m => m.nombre,
                                new
                                {
                                    @class = "form-control" + (ViewData.ModelState["nombre"]?.Errors?.Count > 0 ? " is-invalid" : ""),
                                    placeholder = "Nombre",
                                    maxlength = "100",
                                    id = "Nombre"
                                })
                            @Html.LabelFor(m => m.nombre, "Nombre del Insumo")
                            @Html.ValidationMessageFor(m => m.nombre, "", new { @class = "invalid-feedback d-block" })
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating">
                            @Html.DropDownListFor(m => m.MEDIDAS_id_medida,
                                ViewBag.ListaMedidas as SelectList,
                                "Seleccione una medida",
                                new
                                {
                                    @class = "form-select" + (ViewData.ModelState["MEDIDAS_id_medida"]?.Errors?.Count > 0 ? " is-invalid" : ""),
                                    id = "MedidaSelect"
                                })
                            <label for="MedidaSelect">Unidad de Medida</label>
                            @Html.ValidationMessageFor(m => m.MEDIDAS_id_medida, "", new { @class = "invalid-feedback d-block" })
                        </div>
                    </div>

                    <div class="col-md-12">
                        <div class="form-floating">
                            @Html.TextAreaFor(m => m.descripcion,
                                new
                                {
                                    @class = "form-control" + (ViewData.ModelState["descripcion"]?.Errors?.Count > 0 ? " is-invalid" : ""),
                                    placeholder = "Descripción",
                                    style = "height: 120px",
                                    maxlength = "200",
                                    id = "Descripcion"
                                })
                            @Html.LabelFor(m => m.descripcion, "Descripción")
                            @Html.ValidationMessageFor(m => m.descripcion, "", new { @class = "invalid-feedback d-block" })
                        </div>
                    </div>

                    <div class="col-md-12">
                        <div class="form-check form-switch ps-5 mt-2">
                            @Html.CheckBoxFor(m => m.estado, new { @class = "form-check-input", style = "transform: scale(1.2);" })
                            <label class="form-check-label fw-bold ms-2" for="estado">Insumo Activo</label>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">
                    <button type="submit" class="btn btn-warning px-4">
                        <i class="fas fa-save me-1"></i> Actualizar
                    </button>
                    @Html.ActionLink("Volver", "Index", null, new { @class = "btn btn-secondary px-4" })
                </div>
            }
        </div>
    </div>

    @{
        var presentaciones = ViewBag.Presentaciones as List<CapaModelo.CMPresentacionInsumo>;
    }
    @if (presentaciones != null)
    {
        <div class="card shadow-sm border-0 rounded-4 mt-4 mb-4">
            <div class="card-header bg-light rounded-top-4">
                <h5 class="mb-0"><i class="fas fa-boxes me-2"></i>Presentaciones de compra</h5>
                <small class="text-muted">
                    Cómo se compra este insumo y cuántos <strong>@Model.Abreviatura</strong> trae cada una
                    (ej. Quintal = 46 kg, Racimo = 50 und, Pollo entero = 8 presas). Al comprar se elige la presentación
                    y el stock se suma en @Model.Abreviatura.
                </small>
            </div>
            <div class="card-body">
                @using (Html.BeginForm("AgregarPresentacion", "Insumo", FormMethod.Post, new { @class = "row g-2 align-items-end mb-3" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="idInsumo" value="@Model.id_insumo" />
                    <div class="col-md-5">
                        <label class="form-label small mb-1" for="presNombre">Presentación</label>
                        <input type="text" class="form-control" id="presNombre" name="nombre" maxlength="100" required placeholder="Ej: Quintal" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small mb-1" for="presFactor">Trae (@Model.Abreviatura)</label>
                        <input type="number" class="form-control" id="presFactor" name="factor" min="0.0001" step="any" required placeholder="Ej: 46" />
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary w-100"><i class="fas fa-plus me-1"></i> Guardar</button>
                    </div>
                }

                <table class="table table-sm table-bordered align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Presentación</th>
                            <th class="text-end">Equivale a</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!presentaciones.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted">Sin presentaciones: se compra directamente en @Model.Abreviatura.</td></tr>
                        }
                        @foreach (var p in presentaciones)
                        {
                            <tr class="@(p.estado ? "" : "text-muted")">
                                <td>@p.nombre</td>
                                <td class="text-end">@p.factor.ToString("#,##0.####") @Model.Abreviatura</td>
                                <td class="text-center">
                                    <span class="badge @(p.estado ? "bg-success" : "bg-secondary")">@(p.estado ? "Activa" : "Inactiva")</span>
                                </td>
                                <td class="text-center">
                                    @using (Html.BeginForm("CambiarEstadoPresentacion", "Insumo", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="idInsumo" value="@Model.id_insumo" />
                                        <input type="hidden" name="idPresentacion" value="@p.id_presentacion" />
                                        <input type="hidden" name="estado" value="@(p.estado ? "false" : "true")" />
                                        <button type="submit" class="btn btn-sm @(p.estado ? "btn-outline-danger" : "btn-outline-success")">
                                            @(p.estado ? "Desactivar" : "Activar")
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@section JavaScript {
    <script>
        // Validación de Nombre: Permite letras, números, espacios y guiones (ej: Aceite 5L)
        document.getElementById('Nombre').addEventListener('input', function (e) {
            this.value = this.value.replace(/[^a-zA-Z0-9áéíóúÁÉÍÓÚñÑ\s\-\.]/g, '');
        });

        // Contador de caracteres para descripción
        document.getElementById('Descripcion').addEventListener('input', function (e) {
            const maxLength = 200;
            const currentLength = this.value.length;

            let counter = document.getElementById('descripcion-counter');
            if (!counter) {
                counter = document.createElement('small');
                counter.id = 'descripcion-counter';
                counter.className = 'form-text text-muted text-end d-block mt-1';
                // Subimos dos niveles para salir del form-floating
                this.parentNode.parentNode.appendChild(counter);
            }

            counter.textContent = `${currentLength}/${maxLength} caracteres`;

            if (currentLength >= maxLength) {
                counter.classList.add('text-danger', 'fw-bold');
            } else {
                counter.classList.remove('text-danger', 'fw-bold');
            }
        });

        // Disparar evento input al cargar para que el contador aparezca si hay texto
        document.getElementById('Descripcion').dispatchEvent(new Event('input'));
    </script>
}