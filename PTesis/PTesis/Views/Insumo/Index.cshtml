@model List<CapaModelo.CMInsumo>

@{
    ViewBag.Title = "Listado de Insumos";
}

<div class="container-fluid px-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mt-4">
        <h2 class="fw-bold"><i class="fas fa-box-open me-2 text-primary"></i>Listado de Insumos</h2>
    </div>

    <div class="mt-3">
        @if (ViewBag.PuedeCrear != null && (bool)ViewBag.PuedeCrear)
        {
            @Html.ActionLink("Agregar Insumo", "Create", null, new { @class = "btn btn-primary shadow-sm" })
        }
    </div>

    <div class="card shadow-sm border-0 mb-4 mt-3">
        <div class="card-body">
            <form method="get" action="@Url.Action("Index", "Insumo")" class="row g-2 align-items-center">
                <div class="col-md-9 col-lg-10">
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="fas fa-search"></i></span>
                        <input type="text" name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Buscar por nombre o descripción..." />
                    </div>
                </div>
                <div class="col-md-3 col-lg-2 d-flex gap-2 justify-content-end">
                    <button type="submit" class="btn btn-success w-50"><i class="fas fa-search me-1"></i> Buscar</button>
                    <a href="@Url.Action("Index", "Insumo")" class="btn btn-secondary w-50"><i class="fas fa-undo me-1"></i> Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="w-25">Nombre</th>
                            <th class="w-25">Medida</th>
                            <th class="w-25">Descripción</th>
                            <th class="w-10 text-center">Estado</th>
                            <th class="w-15 text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@item.nombre</td>

                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @item.NombreMedida (@item.Abreviatura)
                                        </span>
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrEmpty(item.descripcion))
                                        {
                                            @item.descripcion
                                        }
                                        else
                                        {
                                            <em class="text-muted small">Sin descripción</em>
                                        }
                                    </td>

                                    <td class="text-center">
                                        @if (item.estado)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactivo</span>
                                        }
                                    </td>

                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            @if (ViewBag.PuedeEditar != null && (bool)ViewBag.PuedeEditar)
                                            {
                                                @Html.ActionLink("Editar", "Edit", new { id = item.id_insumo },
                                                    new { @class = "btn btn-warning btn-sm" })
                                            }

                                            @if (ViewBag.PuedeEliminar != null && (bool)ViewBag.PuedeEliminar)
                                            {
                                                /* Nota: Si usas la lógica de "Eliminar Verificando",
                                                   aquí podrías usar la clase 'btn-eliminar-verificar'
                                                   como hicimos en Proveedores. Por ahora mantengo el estilo simple de Roles.
                                                */
                                                @Html.ActionLink("Eliminar", "Delete", new { id = item.id_insumo },
                                                    new { @class = "btn btn-danger btn-sm ms-1" })
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4">
                                    <i class="fas fa-info-circle me-2 text-muted"></i>
                                    @if (!string.IsNullOrEmpty(ViewBag.Buscar))
                                    {
                                        <span>No se encontraron insumos que coincidan con la búsqueda.</span>
                                    }
                                    else
                                    {
                                        <span>No hay insumos registrados.</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>